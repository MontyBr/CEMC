# Copy to .env and fill in. Only the AMap keys are required.

# AMap (Gaode) — https://console.amap.com/dev/key/app
# A "Web端(JS API)" key and its security code (安全密钥), used for the map itself.
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
# A separate "Web服务" key, used by the server for place search.
AMAP_WEB_SERVICE_KEY=

# Optional: translates free-text searches to Chinese and place names to English.
# Without it, only the built-in glossary is used.
ANTHROPIC_API_KEY=

# Optional: WeChat Official Account (公众号) for the JS-SDK inside WeChat.
# The page's domain must be listed under "JS接口安全域名" (requires ICP filing).
WECHAT_APPID=
WECHAT_SECRET=

PORT=3000
